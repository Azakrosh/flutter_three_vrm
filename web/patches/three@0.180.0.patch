--- a/examples/jsm/controls/OrbitControls.js
+++ b/examples/jsm/controls/OrbitControls.js
@@ -1520,9 +1520,18 @@ function onPointerUp( event ) {
 
 		case 1:
 
+			// A two-pointer gesture may end in a disabled one-pointer mode
+			// (for example constrained zoom with rotation disabled). Reset the
+			// previous dolly state before _onTouchStart() can return early.
+			this.state = _STATE.NONE;
+
 			const pointerId = this._pointers[ 0 ];
 			const position = this._pointerPositions[ pointerId ];
 
+			// Android WebView can deliver cancellation/up events after its
+			// pointer-position entry has already disappeared.
+			if ( position === undefined ) break;
+
 			// minimal placeholder event - allows state correction on pointer-up
 			this._onTouchStart( { pointerId: pointerId, pageX: position.x, pageY: position.y } );
 
