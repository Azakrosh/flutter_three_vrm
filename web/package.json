{
    "name": "flutter-three-vrm-runtime",
    "version": "0.2.0-dev.1",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.33.0",
    "scripts": {
        "build": "node scripts/build.mjs",
        "build:dev": "node scripts/build.mjs --development",
        "verify:build": "node scripts/verify-build.mjs",
        "verify:contract": "node scripts/verify-contract.mjs",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@pixiv/three-vrm": "3.5.5",
        "@pixiv/three-vrm-animation": "3.5.5",
        "three": "0.180.0"
    },
    "devDependencies": {
        "@types/three": "0.180.0",
        "esbuild": "0.28.2",
        "typescript": "7.0.2",
        "vitest": "5.0.3"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild"
        ],
        "patchedDependencies": {
            "three@0.180.0": "patches/three@0.180.0.patch"
        }
    }
}
